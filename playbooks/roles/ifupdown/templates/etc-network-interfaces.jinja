#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}
{% for item in ifupdown_interfaces %}
# Configuration for {{ item.interface }}
{% if item.type in ["interface", "bridge", "loopback"] %}
auto {{ item.interface }}
{% endif %}
iface {{ item.interface }} inet {{ item.mode }}
{% if item.mode == "static" %}
{% if item.macAddress is defined %}
    hwaddress {{ item.macAddress }}
{% endif %}
{% if item.ip is defined %}
{# NOTE: Emit this newline explicitly because the inline mask conditional is trimmed. #}
    address {{ item.ip }}{% if item.mask is defined %}/{{ item.mask }}{% endif %}{{ "\n" }}{% endif %}
{% if item.gateway is defined %}
    gateway {{ item.gateway }}
{% endif %}
{% if item.dns is defined and item.dns|length > 0 %}
    dns-nameservers{% for d in item.dns %} {{ d }}{% endfor %}
{% endif %}
{% endif %}
{% if item.type == "bridge" %}
    bridge-ports {{ item.bridge_port | default('none') }}
    bridge-stp off
{% endif %}
{{ "\n" if not loop.last else "" }}{% endfor %}
